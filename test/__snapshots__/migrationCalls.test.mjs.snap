                        "maxLength": 5
                      },
                      "city": {
                        "bsonType": "string",
                        "maxLength": 100
                      },
                      "province": {
                        "bsonType": "string",
                        "minLength": 2,
                        "maxLength": 2
                      },
                      "position": {
                        "bsonType": "object",
                        "title": "object",
                        "required": [
                          "type",
