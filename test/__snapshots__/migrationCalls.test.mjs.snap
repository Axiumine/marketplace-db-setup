                  },
                  "uniqueCode": {
                    "bsonType": "string",
                    "minLength": 7,
                    "maxLength": 7
                  },
                  "certifiedEmail": {
                    "bsonType": "string",
                    "maxLength": 250
                  },
                  "address": {
                    "bsonType": "object",
                    "title": "object",
                    "required": [
                      "street",
                      "postalCode",
                      "city",
                      "province",
                      "position"
