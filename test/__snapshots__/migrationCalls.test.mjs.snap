                            "bsonType": "string",
                            "maxLength": 5,
                            "description": "Point"
                          },
                          "coordinates": {
                            "bsonType": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": [
                              {
                                "bsonType": [
                                  "double",
                                  "int",
                                  "long"
                                ],
                                "maximum": 180,
                                "minimum": -180,
                                "description": "longitude"
                              },
                              {
                                "bsonType": [
                                  "double",
                                  "int",
                                  "long"
                                ],
                                "maximum": 90,
                                "minimum": -90,
                                "description": "latitude"
                              }
                            ]
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  },
                  "registryExtract": {
                    "bsonType": "string",
                    "maxLength": 1000
                  },
                  "publicName": {
                    "bsonType": "string",
                    "maxLength": 100,
                    "description": "the trading name shown to customers, not the registered legal name"
                  },
                  "slug": {
                    "bsonType": "string",
                    "minLength": 2,
                    "maxLength": 120,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "URL segment of /shop/:slug — lowercase, digits and single hyphens"
                  },
                  "description": {
                    "bsonType": "string",
                    "maxLength": 2000
                  },
                  "published": {
                    "bsonType": "bool",
                    "description": "false until the owner puts the shop live; nothing public reads a false row"
                  },
                  "deleted": {
                    "bsonType": "date"
                  },
