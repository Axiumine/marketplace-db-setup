                "$or": [
                  {
                    "$eq": [
                      {
                        "$type": "$defaultAddress"
                      },
                      "missing"
                    ]
                  },
                  {
                    "$in": [
                      "$defaultAddress",
                      {
                        "$map": {
                          "input": {
                            "$ifNull": [
                              "$addresses",
                              []
                            ]
                          },
                          "in": "$$this._id"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "validationLevel": "strict",
        "validationAction": "error"
      }
