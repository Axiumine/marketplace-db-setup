MONGO_DEV_UDBOWNER=
MONGO_DEV_URW=
MONGO_DEV_PWD=
MONGO_DEV_AUTH_ADMIN=
MONGO_DEV_DB=
MONGO_DEV_CONN_STRING=
SEED_DEMO=false

# C S F L E   (ADR-029)
#
# Read by the four `*-encrypted` migrations, and ONLY when they find documents to convert — a
# database replayed from empty needs neither variable. A dev rebuild with SEED_DEMO=true does.
#
# ⚠️ CSFLE_MASTER_KEY_PATH must name the SAME 96-byte file the nine services read. The data keys in
# the vault are encrypted under it, so a migration run against a different master key mints keys the
# platform cannot use and every field it converts becomes an undecryptable blob. Losing this file
# loses every encrypted field on the platform, permanently — there is no escrow and no reset. Keep it
# outside the repo; it is gitignored, and it is not a credential that can be rotated by replacing it.
CSFLE_MASTER_KEY_PATH=
#
# ⚠️ The namespace is `<the database this .env points at>.__keyVault` — the SAME database, not a
# vault database of its own. Every user on this cluster is scoped to one database (dbOwner or
# readWrite on it and nothing else), so a vault anywhere else answers `Unauthorized` on the very
# first `createIndex`, for the migrations and for all nine services alike. Giving each of ten users a
# second grant would buy nothing: the vault holds data keys that are themselves encrypted under the
# master key file, so reading it without that file yields nothing, and the file is what the split
# would have been protecting. Set it to `${MONGO_DEV_DB}.__keyVault` here and to that service's own
# database in each service's .env — the test blocks below get their own throwaway database's name.
CSFLE_KEY_VAULT_NAMESPACE=

# K E Y G R I P   S E E D   (ADR-034)
#
# Read by `yarn seed:keygrip` and by nothing else here — no migration touches Redis. The script mints
# the cookie-signing key set the five services that sign or read a session cookie refuse to boot
# without, so it runs ONCE per machine, before any service starts (SETUP.md lists it there).
#
# ⚠️ Every value in this block must be the SAME one the five services carry. The keys live at
# `<REDIS_KEY>keygrip`, so a seed run against a different REDIS_KEY writes a record nobody reads and
# the fleet still refuses to start; a different KEYGRIP_KEK writes one they cannot open, which is the
# louder half of the same mistake — they name it KEYGRIP_KEK_MISMATCH and exit 1.
REDIS_IS_CLUSTER=1
#
# Read ONLY when REDIS_IS_CLUSTER is not exactly the string '1' — the same switch koa-utils makes, so
# the record lands on the node the services look for it on. An empty value is not an error on that
# branch: node-redis falls back to redis://localhost:6379 and seeds the wrong server rather than
# refusing. Set it before flipping the flag.
REDIS_URL=
REDIS_DB1_HOST=db1
REDIS_DB2_HOST=db2
REDIS_DB3_HOST=db3
REDIS_DB1_PORT=6379
REDIS_DB2_PORT=6379
REDIS_DB3_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY=marketplaceDev:
#
# ⚠️ The key that the signing keys are sealed under, not a signing key itself. Base64 of exactly 32
# bytes — `openssl rand -base64 32` — and the seed refuses anything else rather than padding it.
# Losing it does NOT lose the platform: re-seed with --force and everyone signs in again.
KEYGRIP_KEK=
#
# Optional, and only on a machine that ran the pre-ADR-034 arrangement. If KEYGRIP_KEY_1 is present
# the seed ADOPTS it as the first key rather than minting a fresh one, so every session cookie
# already signed with it stays valid and nobody is logged out by the move. KEYGRIP_KEY_2 comes along
# as the second key when it is there; alone it is ignored, because it was never the signer.
# ⚠️ Copy the values from a service's .env, run the seed once, then delete them from both — they are
# read by nothing after that, and a signing key sitting in an environment file is what ADR-034 exists
# to remove. A fresh machine leaves both empty.
KEYGRIP_KEY_1=
KEYGRIP_KEY_2=

# Qodana Cloud token (see qodana.sh). Never commit a real value here — this file is the
# committed placeholder template; the real token lives only in the gitignored .env.
QODANA_TOKEN=


# T E S T   (optional — dedicated throwaway server/db for `yarn test`; DB is dropped)
#
# The suite assembles its URL from CONN_STRING + UDBOWNER + PWDDBOWNER + AUTH_ADMIN.
# It uses the DB OWNER pair: it drops the database and the migrations create
# collections, validators and indexes. The R/W pair below is not read by the suite.
# Leave the whole block empty and the suite skips instead of running.

# DB OWNER USER
MONGO_TEST_UDBOWNER=
MONGO_TEST_PWDDBOWNER=

# R/W USER
MONGO_TEST_UDBRW=
MONGO_TEST_PWDDBRW=

MONGO_TEST_AUTH_ADMIN=
MONGO_TEST_DB=
MONGO_TEST_CONN_STRING=

# One ready-made URL, credentials and authSource already in it. Read by the suite and given
# precedence OVER the four assembled pieces above — only the inline TEST_MONGO_URL, which is passed
# on the command line and never stored, outranks it. Leave it EMPTY: the assembled form is what this
# template is built around, and a stale value here silently wins over every edit made above it.
# It exists in the template because it exists in the resolver, and a variable the code honours but
# the template never names is one nobody knows to clear when it is the thing pointing the suite at
# the wrong database.
MONGO_TEST_URL=
